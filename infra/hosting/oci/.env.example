# Set this to a DNS hostname with an A record pointing to the OCI VM public IP.
API_DOMAIN=api.example.org
ACME_EMAIL=ops@example.org

# Supabase Auth project configuration. The publishable key is public configuration.
# Do not put a secret/service-role key or a user password here.
HEMOSCOPE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
HEMOSCOPE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
