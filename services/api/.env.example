# Local development only. Copy to .env and adjust only when the service is enabled.
HEMOSCOPE_API_VERSION=0.1.0
HEMOSCOPE_INFERENCE_PROVIDER=none
HEMOSCOPE_ENABLE_DEMO_MOCK=false
HEMOSCOPE_MAX_UPLOAD_BYTES=10485760
HEMOSCOPE_MAX_IMAGE_PIXELS=40000000

# Development defaults only; calibrate using representative microscope images.
HEMOSCOPE_QUALITY_MIN_FIELD_WIDTH=640
HEMOSCOPE_QUALITY_MIN_FIELD_HEIGHT=480
HEMOSCOPE_QUALITY_MIN_CROP_WIDTH=96
HEMOSCOPE_QUALITY_MIN_CROP_HEIGHT=96
HEMOSCOPE_QUALITY_MIN_LAPLACIAN_VARIANCE=50
HEMOSCOPE_QUALITY_MIN_MEAN_BRIGHTNESS=30
HEMOSCOPE_QUALITY_MAX_MEAN_BRIGHTNESS=225
HEMOSCOPE_QUALITY_MAX_OVEREXPOSED_FRACTION=0.15
HEMOSCOPE_QUALITY_MAX_UNDEREXPOSED_FRACTION=0.30

# Placeholders only. Keep real credentials on the server and outside version control.
HEMOSCOPE_HUAWEI_REGION=
HEMOSCOPE_HUAWEI_OBS_BUCKET=
HEMOSCOPE_HUAWEI_OBS_ENDPOINT=
HEMOSCOPE_HUAWEI_ACCESS_KEY_ID=
HEMOSCOPE_HUAWEI_SECRET_ACCESS_KEY=
HEMOSCOPE_HUAWEI_MODELARTS_ENDPOINT=
HEMOSCOPE_HUAWEI_ECS_INFERENCE_URL=
