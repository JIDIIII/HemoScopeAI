# Android phone: replace localhost with the development computer's LAN IPv4 address.
# Both devices must be on the same trusted Wi-Fi network.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Set mock only for development UI testing; production builds always use the real API.
EXPO_PUBLIC_API_MODE=real
# Hosted builds use Supabase Auth; local development stays open against the local API.
EXPO_PUBLIC_AUTH_MODE=disabled
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
